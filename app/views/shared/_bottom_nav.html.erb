<nav class="bottom-nav">
  <%= link_to profile_path, class: "bottom-nav-item" do %>
    <i class="fa-solid fa-user"></i>
    <span>Profil</span>
  <% end %>

  <%= link_to suggestions_path, class: "bottom-nav-center" do %>
    <%= image_tag "logo-orb.png", alt: "Découvrir" %>
  <% end %>

  <%= link_to conversations_path, class: "bottom-nav-item bottom-nav-messages" do %>
    <span class="bottom-nav-messages__icon">
      <i class="fa-solid fa-comment-dots"></i>
      <%= render "notifications/badge", count: Notification.badge_count_for(current_user) %>
    </span>
    <span>Messages</span>
  <% end %>
</nav>
