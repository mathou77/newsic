<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Newsic" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Newsic">
    <meta name="theme-color" content="#050510">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="manifest" href="<%= asset_path 'manifest.json' %>">
    <%= render 'shared/ios_pwa_links' %>

    <%= yield :head %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <div class="mobile-app" data-controller="notifications">
        <%= turbo_stream_from "notifications:#{current_user.id}" %>
        <%= render "notifications/panel",
              notifications: current_user.notifications.unread.recent %>
        <%= yield %>
        <%= render "shared/bottom_nav" unless content_for?(:no_bottom_nav) %>
      </div>
    <% else %>
      <div class="mobile-app">
        <%= yield %>
      </div>
    <% end %>
  </body>

</html>
