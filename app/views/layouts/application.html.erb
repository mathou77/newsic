<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Newsic" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=no, maximum-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Newsic">
    <meta name="theme-color" content="#050510">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="manifest" href="<%= asset_path 'manifest.json' %>">
    <%= render 'shared/ios_pwa_links' %>

    <%= yield :head %>

    <meta name="vapid-public-key" content="<%= ENV['VAPID_PUBLIC_KEY'] %>">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <div class="mobile-app" data-controller="notifications">
        <%= turbo_stream_from "notifications:#{current_user.id}" %>

        <%# Toast container — new toasts are prepended here via Turbo Stream %>
        <div id="toast_container" class="toast-container" aria-live="polite"></div>

        <%= yield %>
        <%= render "shared/bottom_nav" unless content_for?(:no_bottom_nav) %>
      </div>
    <% else %>
      <div class="mobile-app">
        <%= yield %>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <script nonce="<%= request.content_security_policy_nonce %>">
        (function () {
          if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;

          navigator.serviceWorker.register('/service-worker', { scope: '/' })
            .then(function (reg) {
              window._swRegistration = reg;
            })
            .catch(function (err) {
              console.warn('[SW] Registration failed:', err);
            });
        })();
      </script>
    <% end %>
  </body>
</html>
