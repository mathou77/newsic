<%# Reaction buttons + counter. Replaced in place (Turbo) on every toggle. %>
<div class="reactions" id="reactions_<%= message.id %>"
     data-controller="reaction" data-reaction-message-id-value="<%= message.id %>">
  <% summary = message.reaction_summary %>
  <% if summary.any? %>
    <div class="reaction-counts">
      <% summary.each do |emoji, count| %>
        <span class="reaction-count"><%= emoji %> <%= count %></span>
      <% end %>
    </div>
  <% end %>
  <button type="button" class="reaction-trigger" data-action="reaction#togglePicker" aria-label="Réagir">😊</button>
  <div class="reaction-picker" data-reaction-target="picker">
    <% MessageReaction::EMOJIS.each do |emoji| %>
      <button type="button" class="reaction-btn" data-action="reaction#pick" data-emoji="<%= emoji %>"><%= emoji %></button>
    <% end %>
  </div>
</div>
