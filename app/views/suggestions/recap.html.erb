
<div class="recap-container">

  <% if @liked_playlists.any? %>
    <div class="recap-banner">
      🎵 <%= @liked_playlists.count %> titre<%= @liked_playlists.count > 1 ? "s" : "" %> liké<%= @liked_playlists.count > 1 ? "s" : "" %> !
    </div>

    <div class="recap-grid">
      <% @liked_playlists.each do |playlist| %>
        <div class="recap-card">
          <% if playlist.song.image_url.present? %>
            <img src="<%= playlist.song.image_url %>" alt="<%= playlist.song.title %>" class="recap-cover">
          <% else %>
            <div class="recap-cover recap-cover--placeholder">♪</div>
          <% end %>
          <div class="recap-info">
            <span class="recap-title"><%= playlist.song.title %></span>
            <span class="recap-artist"><%= playlist.song.artist %></span>
          </div>
        </div>
      <% end %>
    </div>

  <% else %>
    <div class="recap-empty">
      <p>Tu n'as liké aucun titre cette fois.</p>
    </div>
  <% end %>



  <div data-controller="spotify-save" style="margin-top: 30px;">
    <div data-spotify-save-target="button">
      <%= button_to "Ajouter à Spotify", save_to_spotify_suggestion_path(@suggestion),
          method: :post,
          class: "btn-spotify",
          form: { data: { action: "submit->spotify-save#save" } } %>
    </div>
    <div data-spotify-save-target="confirmation" class="recap-notice d-none">
      🎧 Titres ajoutés à ta playlist Newsic sur Spotify !
    </div>
  </div>

   <%= link_to "Recommencer", suggestions_path, class: "btn-recap" %>

</div>
