<% content_for :head do %>
  <%# Always re-render this page fresh on Turbo navigation: never flash a cached
      snapshot with already-swiped cards or a stale audio state. %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>

<div class="swipe-container"
     data-controller="share-sheet swipe"
     data-swipe-recap-url-value="<%= recap_suggestion_path(@suggestion) %>"
     data-share-sheet-url-value="<%= shares_path %>"
     data-action="touchstart->swipe#touchStart touchend->swipe#touchEnd">

  <div data-controller="filters">
    <button type="button" class="filters-toggle" id="filters-toggle"
            data-filters-target="toggle"
            data-action="filters#open">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/>
        <circle cx="9" cy="6" r="2" fill="currentColor" stroke="none"/><circle cx="16" cy="12" r="2" fill="currentColor" stroke="none"/><circle cx="11" cy="18" r="2" fill="currentColor" stroke="none"/>
      </svg>
      <span class="filters-badge" id="filters-badge" data-filters-target="badge" style="display:none"></span>
    </button>

    <div class="filters-panel" id="filters-panel" data-filters-target="panel">

      <div class="filters-header">
        <button type="button" class="filters-back" data-action="filters#close" aria-label="Fermer">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <h2 class="filters-title">Filtres</h2>
        <button type="button" class="filters-reset" data-action="filters#reset">Réinitialiser</button>
      </div>

      <%= form_with url: suggestions_path, method: :post, data: { turbo: false }, class: "filters-form" do %>
        <div class="filters-body">

          <%# Surprise me %>
          <button type="button" class="filters-surprise" data-action="filters#surprise">
            <div class="filters-surprise__left">
              <span class="filters-surprise__icon">✦</span>
              <div>
                <p class="filters-surprise__title">Mode découverte</p>
                <p class="filters-surprise__sub">Laisse l'algo te sortir de ta bulle</p>
              </div>
            </div>
            <i class="fa-solid fa-chevron-right filters-surprise__arrow"></i>
          </button>

          <%# Artistes / Titres %>
          <div class="filters-section seed-search"
               id="seed-search"
               data-controller="seed-search"
               data-seed-search-url-value="<%= seed_search_suggestions_path %>"
               data-seed-search-initial-artists-value="<%= (@filters[:seed_artists] || []).to_json %>"
               data-seed-search-initial-artist-images-value="<%= (@filters[:seed_artist_images] || []).to_json %>"
               data-seed-search-initial-tracks-value="<%= (@filters[:seed_tracks] || []).to_json %>"
               data-seed-search-initial-track-images-value="<%= (@filters[:seed_track_images] || []).to_json %>">
            <div class="filters-section__head">
              <span class="filters-section__title">Artistes / Titres</span>
            </div>
            <p class="filters-section__sub">Ajoute jusqu'à 5 exemples</p>
            <input type="text" data-seed-search-target="input" class="seed-input"
                   data-action="input->seed-search#search"
                   placeholder="Rechercher un artiste ou un titre…" autocomplete="off">
            <div class="seed-results" data-seed-search-target="results"></div>
            <div class="seed-chips" data-seed-search-target="chips"></div>
            <div data-seed-search-target="inputs"></div>
          </div>

          <%# Période d'écoute — pills %>
          <div class="filters-section">
            <span class="filters-section__title">Période d'écoute</span>
            <div class="period-pills">
              <% [["4 semaines","short_term"],["6 mois","medium_term"],["Depuis toujours","long_term"]].each do |lbl, val| %>
                <label class="period-pill">
                  <%= radio_button_tag :time_range, val, (@filters[:time_range] || "long_term") == val %>
                  <span><%= lbl %></span>
                </label>
              <% end %>
            </div>
          </div>

          <%# Filtres avancés — collapsible %>
          <div class="filters-finetune is-open" id="finetune-block">
            <button type="button" class="filters-finetune__head" id="finetune-toggle">
              <span>Filtres avancés</span>
              <i class="fa-solid fa-chevron-down filters-finetune__chevron"></i>
            </button>
            <div class="filters-finetune__body">

              <%# Mood %>
              <div class="filter-block">
                <span class="filter-label">Mood</span>
                <div class="mood-pills">
                  <% [["", "✨", "Tous"], ["chill", "🌙", "Chill"], ["energy", "⚡", "Énergie"],
                      ["focus", "🎯", "Focus"], ["happy", "☀️", "Happy"], ["late night", "🌃", "Late night"]].each do |value, icon, lbl| %>
                    <label class="mood-pill <%= 'is-active' if @filters[:mood].to_s == value %>">
                      <%= radio_button_tag :mood, value, @filters[:mood].to_s == value %>
                      <span><%= icon %> <%= lbl %></span>
                    </label>
                  <% end %>
                </div>
              </div>

              <%# Décennie — slider %>
              <% decades = [["","Toutes"],["1970","70s"],["1980","80s"],["1990","90s"],["2000","2000s"],["2010","2010s"],["2020","2020s"]] %>
              <% decade_idx = decades.index { |v, _| v == @filters[:decade].to_s } || 0 %>
              <div class="filter-block">
                <div class="filter-label-row">
                  <span class="filter-label">Décennie</span>
                  <span class="range-value" id="decade-label"><%= decades[decade_idx][1] %></span>
                </div>
                <input type="range" class="range-slider" min="0" max="<%= decades.size - 1 %>" step="1"
                       value="<%= decade_idx %>"
                       data-range-key="decade"
                       autocomplete="off"
                       data-action="input->filters#rangeInput">
                <input type="hidden" name="decade" id="decade-input" value="<%= @filters[:decade] %>">
              </div>

              <%# Tempo — slider %>
              <% tempos = [["","Tous"],["slow","Lent 🐢"],["medium","Moyen 🚶"],["fast","Rapide 🚀"]] %>
              <% tempo_idx = tempos.index { |v, _| v == @filters[:tempo].to_s } || 0 %>
              <div class="filter-block">
                <div class="filter-label-row">
                  <span class="filter-label">Tempo</span>
                  <span class="range-value" id="tempo-label"><%= tempos[tempo_idx][1] %></span>
                </div>
                <input type="range" class="range-slider" min="0" max="<%= tempos.size - 1 %>" step="1"
                       value="<%= tempo_idx %>"
                       data-range-key="tempo"
                       autocomplete="off"
                       data-action="input->filters#rangeInput">
                <input type="hidden" name="tempo" id="tempo-input" value="<%= @filters[:tempo] %>">
              </div>

              <%# Genre — pills %>
              <div class="filter-block">
                <span class="filter-label">Genre</span>
                <div class="era-pills">
                  <% [["Tous",""],["Pop","pop"],["Rock","rock"],["Électro","electronic"],
                      ["Hip-hop","hip-hop"],["R&B","rnb"],["Jazz","jazz"],["Classique","classical"],
                      ["Metal","metal"],["Indie","indie"],["Soul","soul"],["Reggae","reggae"],
                      ["Folk","folk"],["House","house"],["Techno","techno"]].each do |lbl, val| %>
                    <label class="era-pill">
                      <%= radio_button_tag :genre, val, @filters[:genre].to_s == val %>
                      <span><%= lbl %></span>
                    </label>
                  <% end %>
                </div>
              </div>

              <%# Nombre de titres — pills %>
              <div class="filter-block">
                <span class="filter-label">Nombre de titres recommandés</span>
                <div class="era-pills">
                  <% [["10","10"],["25","25"],["50","50"]].each do |lbl, val| %>
                    <label class="era-pill">
                      <%= radio_button_tag :count, val, (@filters[:count] || 10).to_s == val %>
                      <span><%= lbl %></span>
                    </label>
                  <% end %>
                </div>
              </div>

              <%# Switches %>
              <div class="filters-switches">
                <label class="switch">
                  <%= check_box_tag :diverse, "1", @filters[:diverse] %>
                  1 seul titre par artiste
                </label>
                <label class="switch">
                  <%= check_box_tag :discovery, "1", @filters[:discovery] %>
                  <span>Nouveautés seulement <span class="switch__hint">(exclue les artistes que vous connaissez)</span></span>
                </label>
                <label class="switch">
                  <%= check_box_tag :exclude_disliked, "1", @filters[:exclude_disliked] %>
                  <span>Masquer les titres déjà passés <span class="switch__hint">(exclut les sons que vous avez dislikés)</span></span>
                </label>
              </div>

            </div>
          </div>

        </div>

        <div class="filters-footer">
          <%= submit_tag "Appliquer", class: "btn-apply-filters" %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @playlists.any? %>
    <div class="cards-stack" id="cards-stack">
      <% @playlists.each_with_index do |playlist, index| %>
        <div class="swipe-card <%= 'active' if index == 0 %>"
             data-swipe-target="card"
             data-playlist-id="<%= playlist.id %>"
             data-vote-url="<%= vote_suggestion_playlist_path(@suggestion, playlist) %>">

          <div class="flip-card-inner" data-action="click->swipe#flip">
            <div class="flip-card-front">
              <button type="button" class="card-share" data-action="share-sheet#open"
                      data-song-id="<%= playlist.song.id %>" aria-label="Partager">
                <i class="fa-solid fa-paper-plane"></i>
              </button>

              <img src="<%= playlist.song.image_url %>" alt="<%= playlist.song.title %>" class="card-cover" crossorigin="anonymous">

              <div class="card-player-bar">
                <button type="button" class="player-bar__toggle"
                        data-action="click->swipe#togglePlayPause" aria-label="Pause">
                  <i class="fa-solid fa-pause player-bar__icon"></i>
                </button>
                <div class="player-bar__progress">
                  <div class="player-bar__fill"></div>
                </div>
              </div>

              <div class="card-info">
                <div class="card-info__text">
                  <h2><%= playlist.song.title %></h2>
                  <%= link_to playlist.song.artist,
                               artist_path(name: playlist.song.artist),
                               class: "card-artist-link" %>
                </div>
              </div>
            </div>

            <div class="flip-card-back">
              <span class="back-label">
                Pourquoi cette reco ?
              </span>

              <h2><%= playlist.song.title %></h2>

              <p class="back-artist">
                <%= playlist.song.artist %>
              </p>

              <div class="song-insight-box">
                <p>
                  Sélectionné à partir de tes écoutes Spotify pour te faire découvrir un titre proche de ton univers musical.
                </p>
              </div>

              <div class="song-facts">
                <% if playlist.song.album_name.present? %>
                  <p>
                    💿 Issu de l'album
                    <strong><%= playlist.song.album_name %></strong>
                  </p>
                <% end %>

                <% if playlist.song.duration.present? %>
                  <p>
                    ⏱️ Durée :
                    <strong>
                      <%= playlist.song.duration / 60 %>:<%= "%02d" % (playlist.song.duration % 60) %>
                    </strong>
                  </p>
                <% end %>

                <% if playlist.song.respond_to?(:release_year) && playlist.song.release_year.present? %>
                  <p>
                    📅 Année :
                    <strong><%= playlist.song.release_year %></strong>
                  </p>
                <% elsif playlist.song.respond_to?(:year) && playlist.song.year.present? %>
                  <p>
                    📅 Année :
                    <strong><%= playlist.song.year %></strong>
                  </p>
                <% elsif playlist.song.respond_to?(:release_date) && playlist.song.release_date.present? %>
                  <p>
                    📅 Année :
                    <strong><%= playlist.song.release_date.to_s.first(4) %></strong>
                  </p>
                <% end %>
              </div>

              <p class="flip-help">
                Clique pour revenir à la carte
              </p>
            </div>
          </div>

          <audio class="card-audio" data-src="<%= preview_song_path(playlist.song, v: playlist.id) %>" preload="none"></audio>
        </div>
      <% end %>
    </div>

    <div class="swipe-buttons" id="swipe-buttons">
      <button class="btn-dislike" data-action="click->swipe#dislike">✕</button>
      <button class="btn-like" data-action="click->swipe#like">♥&#xFE0E;</button>
    </div>
  <% else %>
    <div class="done-screen">
      <h2>That's it! 🎉</h2>
      <%= link_to "Voir ma playlist", recap_suggestion_path(@suggestion), class: "btn-recap" %>
    </div>
  <% end %>

  <div class="share-sheet" data-share-sheet-target="sheet" hidden>
    <div class="share-sheet__backdrop" data-action="share-sheet#close"></div>
    <div class="share-sheet__panel" data-share-sheet-target="panel">
      <div class="share-sheet__handle"
           data-action="touchstart->share-sheet#dragStart touchmove->share-sheet#dragMove touchend->share-sheet#dragEnd">
        <div class="share-sheet__grabber"></div>
        <div class="share-sheet__header">
          <h3 class="share-sheet__title">Partager à…</h3>
          <button type="button" class="share-sheet__close" data-action="share-sheet#close" aria-label="Fermer">✕</button>
        </div>
      </div>

      <input type="text" class="share-sheet__search" placeholder="Rechercher un ami…"
             autocomplete="off" data-share-sheet-target="search" data-action="input->share-sheet#filter">

      <div class="share-sheet__friends" data-share-sheet-target="friends">
        <% if @friends.empty? %>
          <p class="empty-state">Pas encore d'amis à qui partager.</p>
        <% else %>
          <% @friends.each do |friend| %>
            <button type="button" class="share-friend" data-share-sheet-target="friend"
                    data-friend-id="<%= friend.id %>" data-name="<%= friend.display_name.to_s.downcase %>"
                    data-action="share-sheet#toggleFriend">
              <span class="share-friend__avatar"><%= avatar_for(friend, size: 44) %></span>
              <span class="share-friend__name"><%= friend.display_name %></span>
              <span class="share-friend__check"><i class="fa-solid fa-check"></i></span>
            </button>
          <% end %>
        <% end %>
      </div>

      <input type="text" class="share-sheet__message" placeholder="Ajouter un message (ex: Écoute ça !)"
             autocomplete="off" data-share-sheet-target="message">

      <button type="button" class="share-sheet__send" data-action="share-sheet#send"
              data-share-sheet-target="send">Envoyer</button>
    </div>
  </div>

  <div class="toast" data-share-sheet-target="toast" hidden>Partagé !</div>
</div>
