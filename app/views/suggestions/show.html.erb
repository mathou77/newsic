<% current_mood = (@filters[:mood].presence || @suggestion.mood).to_s
   moods = [["Late Night", "late night", "fa-moon"], ["Chill", "chill", "fa-cloud"],
            ["Energy", "energy", "fa-bolt"], ["Focus", "focus", "fa-bullseye"],
            ["Happy", "happy", "fa-face-smile"]] %>

<div class="swipe-container" data-recap-url="<%= recap_suggestion_path(@suggestion) %>"
     data-controller="share-sheet" data-share-sheet-url-value="<%= shares_path %>">

  <header class="discover-header">
    <div class="discover-brand">
      <%= image_tag "logo-orb.png", class: "discover-brand__logo", alt: "Newsic" %>
      <span class="discover-brand__name">NEWSIC</span>
    </div>
    <button type="button" class="discover-filters-btn" id="filters-toggle" aria-label="Filtres">
      <i class="fa-solid fa-sliders"></i>
    </button>
  </header>

  <div class="discover-from">
    <span class="discover-from__label">Discover from</span>
    <span class="discover-from__mood">Mood: <%= current_mood.presence&.titleize || "All" %></span>
  </div>

  <div class="mood-tabs">
    <% moods.each do |label, value, icon| %>
      <%= button_to suggestions_path, params: { mood: value }, method: :post,
                    form_class: "mood-tab-form", data: { turbo: false },
                    class: "mood-tab #{'is-active' if current_mood == value}" do %>
        <i class="fa-solid <%= icon %>"></i> <%= label %>
      <% end %>
    <% end %>
  </div>

  <div class="filters-panel" id="filters-panel" data-controller="filters">
    <div class="filters-head">
      <button type="button" class="filters-close" id="filters-close" aria-label="Fermer">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <span class="filters-head__title">Filters</span>
      <button type="button" class="filters-reset" data-action="filters#reset">Reset</button>
    </div>

    <%= form_with url: suggestions_path, method: :post, data: { turbo: false }, class: "filters-form" do %>
      <input type="hidden" name="mood"       value="<%= current_mood %>">
      <input type="hidden" name="time_range" value="<%= @filters[:time_range] || 'medium_term' %>">
      <input type="hidden" name="popularity" value="<%= @filters[:popularity] %>">
      <input type="hidden" name="decade"     value="<%= @filters[:decade] %>">
      <input type="hidden" name="genre"      value="<%= @filters[:genre] %>">
      <input type="hidden" name="count"      value="<%= @filters[:count] || 10 %>">
      <input type="hidden" name="discovery"  value="<%= '1' if @filters[:discovery] %>">

      <button type="button" class="surprise-card <%= 'is-active' if @filters[:discovery] %>" data-action="filters#surprise">
        <span class="surprise-card__icon"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
        <span class="surprise-card__title">Surprise me</span>
        <span class="surprise-card__sub">Let the algorithm pull you out of your bubble</span>
        <span class="surprise-card__chevron"><i class="fa-solid fa-chevron-right"></i></span>
      </button>

      <div class="filters-section seed-search" id="seed-search"
           data-search-url="<%= seed_search_suggestions_path %>"
           data-initial-artists="<%= (@filters[:seed_artists] || []).to_json %>"
           data-initial-tracks="<%= (@filters[:seed_tracks] || []).to_json %>">
        <div class="filters-section__head">
          <h3 class="filters-section__title">Build your vibe</h3>
          <span class="seed-counter" id="seed-counter">0/5</span>
        </div>
        <p class="filters-section__hint">Add up to 5 examples</p>
        <div class="seed-input-wrap">
          <input type="text" id="seed-input" class="seed-input" autocomplete="off"
                 placeholder="Rechercher un artiste ou un titre…">
          <div class="seed-results" id="seed-results"></div>
        </div>
        <div class="seed-chips" id="seed-chips"></div>
        <div id="seed-inputs"></div>
      </div>

      <div class="filters-section">
        <h3 class="filters-section__title">Recently added</h3>
        <div class="pill-row">
          <% [["Last 24h","short_term"],["Last 7 days","short_term"],["Last 30 days","medium_term"],["All time","long_term"]].each do |lab, val| %>
            <button type="button" class="filter-pill <%= 'is-active' if (@filters[:time_range] || 'medium_term') == val %>"
                    data-field="time_range" data-value="<%= val %>" data-action="filters#pick"><%= lab %></button>
          <% end %>
        </div>
      </div>

      <div class="filters-section">
        <h3 class="filters-section__title">Fine-tune</h3>
        <div class="slider-labels"><span>Mainstream</span><span>Hidden Gems</span></div>
        <input type="range" min="0" max="100" class="fine-slider" data-action="input->filters#slide"
               value="<%= @filters[:popularity] == 'hidden' ? 100 : (@filters[:popularity] == 'mainstream' ? 0 : 50) %>">
      </div>

      <div class="filters-section">
        <h3 class="filters-section__title">Era</h3>
        <div class="pill-row pill-row--wrap">
          <% [["70s","1970"],["80s","1980"],["90s","1990"],["2000s","2000"],["2010s","2010"],["2020s","2020"]].each do |lab, val| %>
            <button type="button" class="filter-pill <%= 'is-active' if @filters[:decade] == val %>"
                    data-field="decade" data-value="<%= val %>" data-toggle="true" data-action="filters#pick"><%= lab %></button>
          <% end %>
        </div>
      </div>

      <div class="filters-section">
        <h3 class="filters-section__title">Genre</h3>
        <div class="pill-row pill-row--wrap">
          <% [["Pop","pop"],["Rock","rock"],["Électro","electronic"],["Hip-hop","hip-hop"],["R&B","rnb"],["Jazz","jazz"],["Metal","metal"],["Indie","indie"],["House","house"],["Techno","techno"]].each do |lab, val| %>
            <button type="button" class="filter-pill <%= 'is-active' if @filters[:genre] == val %>"
                    data-field="genre" data-value="<%= val %>" data-toggle="true" data-action="filters#pick"><%= lab %></button>
          <% end %>
        </div>
      </div>

      <div class="filters-section">
        <h3 class="filters-section__title">Nombre de morceaux</h3>
        <div class="pill-row">
          <% ["10","25","50"].each do |val| %>
            <button type="button" class="filter-pill <%= 'is-active' if (@filters[:count] || 10).to_s == val %>"
                    data-field="count" data-value="<%= val %>" data-action="filters#pick"><%= val %></button>
          <% end %>
        </div>
      </div>

      <div class="filters-switches">
        <label class="switch"><%= check_box_tag :clean_only, "1", @filters[:clean_only] %> Version clean uniquement</label>
        <label class="switch"><%= check_box_tag :diverse, "1", @filters[:diverse] %> 1 titre max par artiste</label>
        <label class="switch"><%= check_box_tag :exclude_liked, "1", @filters[:exclude_liked] %> Ne pas reproposer mes titres likés</label>
      </div>

      <%= submit_tag "Start swiping", class: "btn-start-swiping" %>
    <% end %>
  </div>

  <% if @playlists.any? %>
    <div class="cards-stack" id="cards-stack">
      <% @playlists.each_with_index do |playlist, index| %>
        <div class="swipe-card <%= 'active' if index == 0 %>"
             data-playlist-id="<%= playlist.id %>"
             data-vote-url="<%= vote_suggestion_playlist_path(@suggestion, playlist) %>">

          <div class="flip-card-inner" onclick="flipCard(event, this)">
            <div class="flip-card-front">
              <img src="<%= playlist.song.image_url %>" alt="<%= playlist.song.title %>" class="card-cover">

              <div class="card-info">
                <h2><%= playlist.song.title %></h2>
                <p><%= playlist.song.artist %></p>
              </div>
            </div>

            <div class="flip-card-back">

                <span class="back-label">
                  Pourquoi cette reco ?
                </span>

                <h2><%= playlist.song.title %></h2>

                <p class="back-artist">
                  <%= playlist.song.artist %>
                </p>

                <div class="song-insight-box">
                  <p>
                    Sélectionné à partir de tes écoutes Spotify pour te faire découvrir un titre proche de ton univers musical.
                  </p>
                </div>

                <div class="song-facts">

                  <% if playlist.song.album_name.present? %>
                    <p>
                      💿 Issu de l'album
                      <strong><%= playlist.song.album_name %></strong>
                    </p>
                  <% end %>

                  <% if playlist.song.duration.present? %>
                    <p>
                      ⏱️ Durée :
                      <strong>
                        <%= playlist.song.duration / 60 %>:<%= "%02d" % (playlist.song.duration % 60) %>
                      </strong>
                    </p>
                  <% end %>

                  <% if playlist.song.rank.present? %>
                    <p>
                      🎵 Recommandé parmi les titres les plus pertinents trouvés pour toi.
                    </p>
                  <% end %>

                </div>

                <p class="flip-help">
                  Clique pour revenir à la pochette
                </p>

            </div>
          </div>

          <div class="card-actions">
            <button type="button" class="card-action" data-action="share-sheet#open"
                    data-song-id="<%= playlist.song.id %>" aria-label="Partager">
              <i class="fa-solid fa-share"></i>
            </button>
          </div>

          <audio class="card-audio" src="<%= playlist.song.preview_url %>" preload="auto"></audio>
        </div>
      <% end %>
    </div>

    <div class="swipe-actions">
      <button class="swipe-btn btn-dislike" onclick="vote(this, 'disliked')">
        <i class="fa-solid fa-xmark"></i><span>Not for me</span>
      </button>
      <button type="button" class="play-toggle is-playing" id="play-toggle"
              onclick="togglePlay()" aria-label="Lecture / Pause">
        <i class="fa-solid fa-pause"></i>
      </button>
      <button class="swipe-btn btn-like" onclick="vote(this, 'liked')">
        <i class="fa-solid fa-heart"></i><span>I like it</span>
      </button>
    </div>
    <div class="swipe-hint">‹ Swipe left or right ›</div>
  <% else %>
    <div class="done-screen">
      <h2>That's it! 🎉</h2>
      <%= link_to "Voir ma playlist", recap_suggestion_path(@suggestion), class: "btn-recap" %>
    </div>
  <% end %>

  <%# --- Share bottom sheet --- %>
  <div class="share-sheet" data-share-sheet-target="sheet" hidden>
    <div class="share-sheet__backdrop" data-action="share-sheet#close"></div>
    <div class="share-sheet__panel" data-share-sheet-target="panel">
      <div class="share-sheet__handle"
           data-action="touchstart->share-sheet#dragStart touchmove->share-sheet#dragMove touchend->share-sheet#dragEnd">
        <div class="share-sheet__grabber"></div>
        <h3 class="share-sheet__title">Partager à…</h3>
      </div>

      <input type="text" class="share-sheet__search" placeholder="Rechercher un ami…"
             autocomplete="off" data-share-sheet-target="search" data-action="input->share-sheet#filter">

      <div class="share-sheet__friends" data-share-sheet-target="friends">
        <% if @friends.empty? %>
          <p class="empty-state">Pas encore d'amis à qui partager.</p>
        <% else %>
          <% @friends.each do |friend| %>
            <button type="button" class="share-friend" data-share-sheet-target="friend"
                    data-friend-id="<%= friend.id %>" data-name="<%= friend.display_name.to_s.downcase %>"
                    data-action="share-sheet#toggleFriend">
              <span class="share-friend__avatar"><%= avatar_for(friend, size: 44) %></span>
              <span class="share-friend__name"><%= friend.display_name %></span>
              <span class="share-friend__check"><i class="fa-solid fa-check"></i></span>
            </button>
          <% end %>
        <% end %>
      </div>

      <input type="text" class="share-sheet__message" placeholder="Ajouter un message (ex: Écoute ça !)"
             autocomplete="off" data-share-sheet-target="message">

      <button type="button" class="share-sheet__send" data-action="share-sheet#send"
              data-share-sheet-target="send">Envoyer</button>
    </div>
  </div>

  <div class="toast" data-share-sheet-target="toast" hidden>Partagé !</div>
</div>

<% if @playlists.any? %>
  <div id="tap-overlay" class="tap-overlay">
    <div class="tap-overlay__content">
      <div class="tap-overlay__icon">🎵</div>
      <p>Appuie pour démarrer</p>
    </div>
  </div>
<% end %>

<script>
  (function () {
    if (window.__newsicSwipe) return;
    window.__newsicSwipe = true;
    window.__newsicAudioUnlocked = false;

    function syncPlayIcon(isPlaying) {
      const btn = document.getElementById('play-toggle');
      if (!btn) return;
      btn.classList.toggle('is-playing', isPlaying);
      const icon = btn.querySelector('i');
      if (icon) icon.className = isPlaying ? 'fa-solid fa-pause' : 'fa-solid fa-play';
    }

    function currentAudio() {
      const active = document.querySelector('.swipe-card.active');
      return active ? active.querySelector('.card-audio') : null;
    }

    function playCurrentAudio() {
      document.querySelectorAll('.card-audio').forEach(a => {
        a.pause();
        a.currentTime = 0;
      });

      const audio = currentAudio();
      if (audio) {
        audio.play()
          .then(() => syncPlayIcon(true))
          .catch(() => syncPlayIcon(false));
      }
    }

    window.togglePlay = function () {
      unlockAudio();

      const audio = currentAudio();
      if (!audio) return;

      if (audio.paused) {
        audio.play().then(() => syncPlayIcon(true)).catch(() => {});
      } else {
        audio.pause();
        syncPlayIcon(false);
      }
    };

    function unlockAudio() {
      if (window.__newsicAudioUnlocked) return;

      window.__newsicAudioUnlocked = true;

      const overlay = document.getElementById('tap-overlay');
      if (overlay) overlay.style.display = 'none';

      playCurrentAudio();
    }

    window.flipCard = function (event, element) {
      if (event.target.closest('.swipe-buttons')) return;
      element.classList.toggle('is-flipped');
    };

    window.vote = function (_btn, status) {
      unlockAudio();

      const card = document.querySelector('.swipe-card.active');
      if (!card) return;
      const container = document.querySelector('.swipe-container');
      const recapUrl = container ? container.dataset.recapUrl : '/';

      fetch(card.dataset.voteUrl, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ status })
      });

      card.classList.add(status === 'liked' ? 'fly-right' : 'fly-left');

      setTimeout(() => {
        card.remove();

        const remaining = document.querySelectorAll('.swipe-card');

        if (remaining.length === 0) {
          window.location.href = recapUrl;
        } else {
          remaining[0].classList.add('active');
          playCurrentAudio();
        }
      }, 400);
    };

    let startX = 0;

    document.addEventListener('touchstart', e => {
      startX = e.touches[0].clientX;
    });

    document.addEventListener('touchend', e => {
      const diff = e.changedTouches[0].clientX - startX;
      const active = document.querySelector('.swipe-card.active');

      if (!active) return;

      if (diff > 80) window.vote(active.querySelector('.btn-like'), 'liked');
      if (diff < -80) window.vote(active.querySelector('.btn-dislike'), 'disliked');
    });

    function initPage() {
      const container = document.querySelector('.swipe-container');
      if (!container || container.dataset.swipeReady === '1') return;

      container.dataset.swipeReady = '1';

      const overlay = document.getElementById('tap-overlay');
      if (overlay) overlay.addEventListener('click', unlockAudio);

      const filtersToggle = document.getElementById('filters-toggle');
      const filtersPanel  = document.getElementById('filters-panel');
      const filtersClose  = document.getElementById('filters-close');

      if (filtersToggle && filtersPanel) {
        filtersToggle.addEventListener('click', () => filtersPanel.classList.add('open'));
      }

      if (filtersClose && filtersPanel) {
        filtersClose.addEventListener('click', () => filtersPanel.classList.remove('open'));
      }

      const active = document.querySelector('.swipe-card.active');

      if (active) {
        active.querySelector('.card-audio').play().then(() => {
          window.__newsicAudioUnlocked = true;
          if (overlay) overlay.style.display = 'none';
          syncPlayIcon(true);
        }).catch(() => {});
      }

      initSeedSearch();
    }

    document.addEventListener('turbo:load', initPage);
    document.addEventListener('DOMContentLoaded', initPage);

    function initSeedSearch() {
      const root = document.getElementById('seed-search');
      if (!root) return;

      const searchUrl = root.dataset.searchUrl;
      const input     = document.getElementById('seed-input');
      const resultsEl = document.getElementById('seed-results');
      const chipsEl   = document.getElementById('seed-chips');
      const inputsEl  = document.getElementById('seed-inputs');

      const counterEl = document.getElementById('seed-counter');
      let seeds = [];

      JSON.parse(root.dataset.initialArtists || '[]').forEach(name => {
        seeds.push({ kind: 'artist', value: name, label: name, image: null });
      });

      JSON.parse(root.dataset.initialTracks || '[]').forEach(entry => {
        const [artist, title] = entry.split('|');
        seeds.push({ kind: 'track', value: entry, label: title + ' — ' + artist, image: null });
      });

      function render() {
        chipsEl.innerHTML = '';
        inputsEl.innerHTML = '';

        seeds.forEach((s, i) => {
          const chip = document.createElement('span');
          chip.className = 'seed-chip';

          const thumb = document.createElement('span');
          thumb.className = 'seed-chip__thumb' + (s.kind === 'artist' ? ' seed-chip__thumb--round' : '');
          if (s.image) thumb.style.backgroundImage = `url(${s.image})`;
          else thumb.textContent = s.kind === 'artist' ? '🎤' : '🎵';

          const txt = document.createElement('span');
          txt.className = 'seed-chip__label';
          txt.textContent = s.label;

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'seed-chip__remove';
          btn.textContent = '×';
          btn.addEventListener('click', () => { seeds.splice(i, 1); render(); });

          chip.append(thumb, txt, btn);
          chipsEl.appendChild(chip);

          const hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = s.kind === 'artist' ? 'seed_artists[]' : 'seed_tracks[]';
          hidden.value = s.value;
          inputsEl.appendChild(hidden);
        });

        if (counterEl) counterEl.textContent = seeds.length + '/5';
      }

      function addSeed(seed) {
        if (seeds.length >= 5) return;
        const dup = seeds.some(s => s.kind === seed.kind && s.value.toLowerCase() === seed.value.toLowerCase());
        if (!dup) { seeds.push(seed); render(); }
        input.value = '';
        resultsEl.innerHTML = '';
      }

      function resultRow(seed) {
        const row = document.createElement('div');
        row.className = 'seed-result';

        const thumb = document.createElement('span');
        thumb.className = 'seed-result__thumb' + (seed.kind === 'artist' ? ' seed-result__thumb--round' : '');
        if (seed.image) thumb.style.backgroundImage = `url(${seed.image})`;
        else thumb.textContent = seed.kind === 'artist' ? '🎤' : '🎵';

        const txt = document.createElement('span');
        txt.className = 'seed-result__label';
        txt.textContent = seed.label;

        const add = document.createElement('button');
        add.type = 'button';
        add.className = 'seed-result__add';
        add.innerHTML = '<i class="fa-solid fa-plus"></i>';

        row.append(thumb, txt, add);
        row.addEventListener('click', () => addSeed(seed));
        return row;
      }

      function renderResults(data) {
        resultsEl.innerHTML = '';

        (data.artists || []).forEach(a => {
          resultsEl.appendChild(resultRow({ kind: 'artist', value: a.name, label: a.name, image: a.image }));
        });

        (data.tracks || []).forEach(t => {
          const label = t.title + ' — ' + t.artist;
          resultsEl.appendChild(resultRow({ kind: 'track', value: t.artist + '|' + t.title, label, image: t.image }));
        });
      }

      let timer = null;

      input.addEventListener('input', () => {
        clearTimeout(timer);

        const q = input.value.trim();

        if (q.length < 2) {
          resultsEl.innerHTML = '';
          return;
        }

        timer = setTimeout(() => {
          fetch(searchUrl + '?q=' + encodeURIComponent(q), {
            headers: { 'Accept': 'application/json' }
          })
            .then(r => r.json())
            .then(renderResults)
            .catch(() => {
              resultsEl.innerHTML = '';
            });
        }, 300);
      });

      document.addEventListener('click', e => {
        if (!root.contains(e.target)) resultsEl.innerHTML = '';
      });

      render();
    }
  })();
</script>
