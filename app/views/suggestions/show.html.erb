<div class="swipe-container" data-recap-url="<%= recap_suggestion_path(@suggestion) %>"
     data-controller="share-sheet" data-share-sheet-url-value="<%= shares_path %>">
  <button type="button" class="filters-toggle" id="filters-toggle">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/>
      <circle cx="9" cy="6" r="2" fill="currentColor" stroke="none"/><circle cx="16" cy="12" r="2" fill="currentColor" stroke="none"/><circle cx="11" cy="18" r="2" fill="currentColor" stroke="none"/>
    </svg>
    <span class="filters-badge" id="filters-badge" style="display:none"></span>
  </button>

  <div class="filters-panel" id="filters-panel">
    <button type="button" class="filters-close" id="filters-close">×</button>

    <%= form_with url: suggestions_path, method: :post, data: { turbo: false, controller: "filters" }, class: "filters-form" do %>
      <%# 1. Artistes / Titres %>
      <div class="seed-search"
           id="seed-search"
           data-search-url="<%= seed_search_suggestions_path %>"
           data-initial-artists="<%= (@filters[:seed_artists] || []).to_json %>"
           data-initial-tracks="<%= (@filters[:seed_tracks] || []).to_json %>">
        <span class="seed-search__label">Artistes / Titres</span>
        <input type="text" id="seed-input" class="seed-input"
               placeholder="Rechercher un artiste ou un titre…" autocomplete="off">
        <div class="seed-results" id="seed-results"></div>
        <div class="seed-chips" id="seed-chips"></div>
        <div id="seed-inputs"></div>
      </div>

      <%# 2. Nombre de titres %>
      <label>
        Nombre de titres recommandés
        <%= select_tag :count, options_for_select(
          [["10", "10"], ["25", "25"], ["50", "50"]],
          (@filters[:count] || 10).to_s) %>
      </label>

      <%# 3. Période d'écoute %>
      <label>
        Période d'écoute
        <%= select_tag :time_range, options_for_select(
          [["4 dernières semaines", "short_term"], ["6 derniers mois", "medium_term"],
           ["Depuis toujours", "long_term"]],
          @filters[:time_range] || "long_term") %>
      </label>

      <%# 4. Genre %>
      <label>
        Genre
        <%= select_tag :genre, options_for_select(
          [["--", ""], ["Pop", "pop"], ["Rock", "rock"], ["Électro", "electronic"],
           ["Hip-hop", "hip-hop"], ["R&B", "rnb"], ["Jazz", "jazz"], ["Classique", "classical"],
           ["Metal", "metal"], ["Indie", "indie"], ["Soul", "soul"], ["Reggae", "reggae"],
           ["Folk", "folk"], ["House", "house"], ["Techno", "techno"]],
          @filters[:genre]) %>
      </label>

      <%# 5. Mood avec icônes %>
      <div class="filter-block">
        <span class="filter-label">Mood</span>
        <div class="mood-pills">
          <% [["", "✨", "Tous"], ["chill", "🌙", "Chill"], ["energy", "⚡", "Énergie"],
              ["focus", "🎯", "Focus"], ["happy", "☀️", "Happy"], ["late night", "🌃", "Late night"]].each do |value, icon, label| %>
            <label class="mood-pill <%= 'is-active' if @filters[:mood].to_s == value %>">
              <%= radio_button_tag :mood, value, @filters[:mood].to_s == value %>
              <span><%= icon %> <%= label %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%# 6-7-8. Filtres curseurs %>
      <div class="filter-block">
        <span class="filter-label">Filtres avancés</span>
        <div class="range-filters">

          <%# Décennie %>
          <% decade_values = ["1960", "1970", "1980", "1990", "2000", "2010", "2020"] %>
          <% current_decade_idx = [decade_values.index(@filters[:decade].to_s) || 0, 0].max %>
          <% decade_active = @filters[:decade].present? %>
          <div class="range-filter <%= 'is-active' if decade_active %>" id="decade-block">
            <button type="button" class="range-chip" id="decade-toggle">
              Décennie<span class="range-chip__value" id="decade-label"><%= decade_active ? " · #{@filters[:decade]}s" : "" %></span>
            </button>
            <div class="range-filter__body">
              <input type="range" id="decade-range" min="0" max="6" step="1" value="<%= current_decade_idx %>" class="filter-range">
            </div>
            <input type="hidden" name="decade" id="decade-hidden" value="<%= decade_active ? @filters[:decade] : '' %>">
          </div>


          <%# Tempo %>
          <% tempo_values = ["slow", "medium", "fast"] %>
          <% current_tempo_idx = [tempo_values.index(@filters[:tempo].to_s) || 1, 0].max %>
          <% tempo_active = @filters[:tempo].present? %>
          <div class="range-filter <%= 'is-active' if tempo_active %>" id="tempo-block">
            <button type="button" class="range-chip" id="tempo-toggle">
              Tempo<span class="range-chip__value" id="tempo-label"><%= tempo_active ? " · #{{"slow" => "Lent 🐢", "medium" => "Moyen 🚶", "fast" => "Rapide 🚀"}[@filters[:tempo].to_s]}" : "" %></span>
            </button>
            <div class="range-filter__body">
              <input type="range" id="tempo-range" min="0" max="2" step="1" value="<%= current_tempo_idx %>" class="filter-range">
            </div>
            <input type="hidden" name="tempo" id="tempo-hidden" value="<%= tempo_active ? @filters[:tempo] : '' %>">
          </div>

        </div>
      </div>

      <%# Checkboxes %>
      <div class="filters-switches">
        <label class="switch">
          <%= check_box_tag :diverse, "1", @filters[:diverse] %>
          1 seul titre par artiste
        </label>

        <label class="switch">
          <%= check_box_tag :discovery, "1", @filters[:discovery] %>
          <span>Nouveautés seulement <span style="font-weight: 400; opacity: 0.7;">(exclue les artistes que vous connaissez)</span></span>
        </label>
      </div>

      <div class="filters-actions">
        <%= submit_tag "Appliquer", class: "btn-apply-filters" %>
        <button type="button" class="btn-reset-filters" id="btn-reset-filters">Réinitialiser</button>
      </div>
    <% end %>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const DECADE_LABELS = ["1960s","1970s","1980s","1990s","2000s","2010s","2020s"]
      const DECADE_VALUES = ["1960","1970","1980","1990","2000","2010","2020"]
      const POP_LABELS    = ["Hidden gems 💎","Mainstream 🔥"]
      const POP_VALUES    = ["hidden","mainstream"]
      const TEMPO_LABELS  = ["Lent 🐢","Moyen 🚶","Rapide 🚀"]
      const TEMPO_VALUES  = ["slow","medium","fast"]

      function initRange(rangeId, labelId, hiddenId, toggleId, blockId, labels, values) {
        const range  = document.getElementById(rangeId)
        const label  = document.getElementById(labelId)
        const hidden = document.getElementById(hiddenId)
        const toggle = document.getElementById(toggleId)
        const block  = document.getElementById(blockId)
        if (!range || !toggle) return

        range.addEventListener("input", function() {
          const val = labels[parseInt(range.value)]
          label.textContent = " · " + val
          hidden.value = values[parseInt(range.value)]
        })

        toggle.addEventListener("click", function() {
          const active = block.classList.toggle("is-active")
          if (active) {
            const val = labels[parseInt(range.value)]
            label.textContent = " · " + val
            hidden.value = values[parseInt(range.value)]
          } else {
            label.textContent = ""
            hidden.value = ""
          }
        })
      }

      initRange("decade-range", "decade-label", "decade-hidden", "decade-toggle", "decade-block", DECADE_LABELS, DECADE_VALUES)
      initRange("tempo-range",  "tempo-label",  "tempo-hidden",  "tempo-toggle",  "tempo-block",  TEMPO_LABELS,  TEMPO_VALUES)

      // Badge : compte les filtres actifs
      function updateBadge() {
        const badge = document.getElementById("filters-badge")
        const toggle = document.getElementById("filters-toggle")
        if (!badge) return

        let count = 0

        // Seulement le select genre (pas count ni time_range qui ont des valeurs par défaut)
        const genre = document.querySelector(".filters-form select[name='genre']")
        if (genre && genre.value !== "") count++

        // Mood : radio non vide
        const mood = document.querySelector(".filters-form input[name='mood']:checked")
        if (mood && mood.value !== "") count++

        // Curseurs actifs (décennie, tempo)
        document.querySelectorAll(".range-filter.is-active").forEach(() => count++)

        // Checkboxes cochées
        document.querySelectorAll(".filters-form input[type='checkbox']:checked").forEach(() => count++)

        if (count > 0) {
          badge.textContent = count
          badge.style.display = "block"
          toggle.classList.add("is-active")
        } else {
          badge.style.display = "none"
          toggle.classList.remove("is-active")
        }
      }

      // Écoute tous les changements dans le formulaire
      document.querySelector(".filters-form")?.addEventListener("change", updateBadge)
      document.querySelectorAll(".range-chip").forEach(btn => btn.addEventListener("click", () => setTimeout(updateBadge, 50)))

      updateBadge() // init au chargement
    })
  </script>

  <% if @playlists.any? %>
    <div class="cards-stack" id="cards-stack">
      <% @playlists.each_with_index do |playlist, index| %>
        <div class="swipe-card <%= 'active' if index == 0 %>"
             data-playlist-id="<%= playlist.id %>"
             data-vote-url="<%= vote_suggestion_playlist_path(@suggestion, playlist) %>">

          <div class="flip-card-inner" onclick="flipCard(event, this)">
            <div class="flip-card-front">
              <img src="<%= playlist.song.image_url %>" alt="<%= playlist.song.title %>" class="card-cover" crossorigin="anonymous">

              <div class="card-player-bar">
                <button type="button" class="player-bar__toggle" aria-label="Pause">
                  <i class="fa-solid fa-pause player-bar__icon"></i>
                </button>
                <div class="player-bar__progress">
                  <div class="player-bar__fill"></div>
                </div>
              </div>

              <div class="card-info">
                <div class="card-info__text">
                  <h2><%= playlist.song.title %></h2>
                  <p><%= playlist.song.artist %></p>
                </div>
                <button type="button" class="card-share" data-action="share-sheet#open"
                        data-song-id="<%= playlist.song.id %>" aria-label="Partager">
                  <i class="fa-solid fa-share-nodes"></i>
                </button>
              </div>
            </div>

            <div class="flip-card-back">
              <span class="back-label">
                Pourquoi cette reco ?
              </span>

              <h2><%= playlist.song.title %></h2>

              <p class="back-artist">
                <%= playlist.song.artist %>
              </p>

              <div class="song-insight-box">
                <p>
                  Sélectionné à partir de tes écoutes Spotify pour te faire découvrir un titre proche de ton univers musical.
                </p>
              </div>

              <div class="song-facts">
                <% if playlist.song.album_name.present? %>
                  <p>
                    💿 Issu de l'album
                    <strong><%= playlist.song.album_name %></strong>
                  </p>
                <% end %>

                <% if playlist.song.duration.present? %>
                  <p>
                    ⏱️ Durée :
                    <strong>
                      <%= playlist.song.duration / 60 %>:<%= "%02d" % (playlist.song.duration % 60) %>
                    </strong>
                  </p>
                <% end %>

                <% if playlist.song.respond_to?(:release_year) && playlist.song.release_year.present? %>
                  <p>
                    📅 Année :
                    <strong><%= playlist.song.release_year %></strong>
                  </p>
                <% elsif playlist.song.respond_to?(:year) && playlist.song.year.present? %>
                  <p>
                    📅 Année :
                    <strong><%= playlist.song.year %></strong>
                  </p>
                <% elsif playlist.song.respond_to?(:release_date) && playlist.song.release_date.present? %>
                  <p>
                    📅 Année :
                    <strong><%= playlist.song.release_date.to_s.first(4) %></strong>
                  </p>
                <% end %>
              </div>

              <p class="flip-help">
                Clique pour revenir à la carte
              </p>
            </div>
          </div>

          <audio class="card-audio" src="<%= playlist.song.preview_url %>" preload="auto"></audio>
        </div>
      <% end %>
    </div>

    <div class="swipe-buttons" id="swipe-buttons">
      <button class="btn-dislike" onclick="vote(this, 'disliked')">✕</button>
      <button class="btn-like" onclick="vote(this, 'liked')">♥</button>
    </div>
  <% else %>
    <div class="done-screen">
      <h2>That's it! 🎉</h2>
      <%= link_to "Voir ma playlist", recap_suggestion_path(@suggestion), class: "btn-recap" %>
    </div>
  <% end %>

  <div class="share-sheet" data-share-sheet-target="sheet" hidden>
    <div class="share-sheet__backdrop" data-action="share-sheet#close"></div>
    <div class="share-sheet__panel" data-share-sheet-target="panel">
      <div class="share-sheet__handle"
           data-action="touchstart->share-sheet#dragStart touchmove->share-sheet#dragMove touchend->share-sheet#dragEnd">
        <div class="share-sheet__grabber"></div>
        <div class="share-sheet__header">
          <h3 class="share-sheet__title">Partager à…</h3>
          <button type="button" class="share-sheet__close" data-action="share-sheet#close" aria-label="Fermer">✕</button>
        </div>
      </div>

      <input type="text" class="share-sheet__search" placeholder="Rechercher un ami…"
             autocomplete="off" data-share-sheet-target="search" data-action="input->share-sheet#filter">

      <div class="share-sheet__friends" data-share-sheet-target="friends">
        <% if @friends.empty? %>
          <p class="empty-state">Pas encore d'amis à qui partager.</p>
        <% else %>
          <% @friends.each do |friend| %>
            <button type="button" class="share-friend" data-share-sheet-target="friend"
                    data-friend-id="<%= friend.id %>" data-name="<%= friend.display_name.to_s.downcase %>"
                    data-action="share-sheet#toggleFriend">
              <span class="share-friend__avatar"><%= avatar_for(friend, size: 44) %></span>
              <span class="share-friend__name"><%= friend.display_name %></span>
              <span class="share-friend__check"><i class="fa-solid fa-check"></i></span>
            </button>
          <% end %>
        <% end %>
      </div>

      <input type="text" class="share-sheet__message" placeholder="Ajouter un message (ex: Écoute ça !)"
             autocomplete="off" data-share-sheet-target="message">

      <button type="button" class="share-sheet__send" data-action="share-sheet#send"
              data-share-sheet-target="send">Envoyer</button>
    </div>
  </div>

  <div class="toast" data-share-sheet-target="toast" hidden>Partagé !</div>
</div>

<% if @playlists.any? %>
  <div id="tap-overlay" class="tap-overlay">
    <div class="tap-overlay__content">
      <div class="tap-overlay__icon">🎵</div>
      <p>Appuie pour démarrer</p>
    </div>
  </div>
<% end %>

<script>
  (function () {
    if (window.__newsicSwipe) return;
    window.__newsicSwipe = true;

    let playerPaused = false;

    function getActiveBar() {
      const active = document.querySelector('.swipe-card.active');
      if (!active) return {};
      return {
        fill:   active.querySelector('.player-bar__fill'),
        icon:   active.querySelector('.player-bar__icon'),
        toggle: active.querySelector('.player-bar__toggle'),
        audio:  active.querySelector('.card-audio')
      };
    }

    function updatePlayerIcon() {
      const { icon } = getActiveBar();
      if (!icon) return;
      icon.className = playerPaused ? 'fa-solid fa-play player-bar__icon' : 'fa-solid fa-pause player-bar__icon';
    }

    function bindProgressBar(audio, fill) {
      // On retire l'ancien listener en clonant
      const newAudio = audio;
      newAudio.addEventListener('timeupdate', function() {
        if (!newAudio.duration || !fill) return;
        fill.style.width = (newAudio.currentTime / newAudio.duration * 100) + '%';
      });
    }

    // ── Couleur dominante de la cover ───────────────────────────────────────────
    function getDominantColor(img, callback) {
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 32;
        canvas.height = 32;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, 32, 32);
        const data = ctx.getImageData(0, 0, 32, 32).data;

        let r = 0, g = 0, b = 0, count = 0;
        for (let i = 0; i < data.length; i += 16) {
          // Ignore pixels trop sombres ou trop clairs
          const pr = data[i], pg = data[i+1], pb = data[i+2];
          const brightness = (pr + pg + pb) / 3;
          if (brightness > 30 && brightness < 230) {
            r += pr; g += pg; b += pb; count++;
          }
        }
        if (count === 0) { callback(null); return; }
        callback({ r: Math.round(r/count), g: Math.round(g/count), b: Math.round(b/count) });
      } catch(e) { callback(null); }
    }

    function applyCardColor(card) {
      const img = card.querySelector('.card-cover');
      if (!img) return;

      const apply = () => {
        getDominantColor(img, (color) => {
          if (!color) return;
          const { r, g, b } = color;
          // Reset le style inline de la card (border/shadow dynamiques supprimés)
          card.style.borderColor = '';
          card.style.boxShadow = '';
          // Change le fond du container
          const container = document.querySelector('.swipe-container');
          if (!container) return;
          container.style.background = `
            radial-gradient(circle at 50% 40%, rgba(${r},${g},${b},0.45) 0%, rgba(${r},${g},${b},0.08) 55%, #050510 80%),
            #050510
          `;
        });
      };

      if (img.complete) apply();
      else img.addEventListener('load', apply);
    }

    // Applique la couleur à toutes les cards au chargement
    document.querySelectorAll('.swipe-card').forEach(applyCardColor);

    // ── Audio ────────────────────────────────────────────────────────────────────

    function playCurrentAudio() {
      document.querySelectorAll('.card-audio').forEach(a => {
        a.pause();
        a.currentTime = 0;
      });

      playerPaused = false;
      const { audio, fill } = getActiveBar();
      if (fill) fill.style.width = '0%';

      if (audio) {
        audio.play().catch(() => {});
        bindProgressBar(audio, fill);
      }
      updatePlayerIcon();

      // Met à jour le halo de fond pour la nouvelle card
      const newActive = document.querySelector('.swipe-card.active');
      if (newActive) applyCardColor(newActive);
    }

    // Seek : clic ou drag sur la barre de progression
    function seekFromEvent(e, bar) {
      const { audio, fill } = getActiveBar();
      if (!audio || !audio.duration) return;
      const rect = bar.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      audio.currentTime = ratio * audio.duration;
      if (fill) fill.style.width = (ratio * 100) + '%';
    }

    let isSeeking = false;

    document.addEventListener('mousedown', function(e) {
      const bar = e.target.closest('.player-bar__progress');
      if (!bar) return;
      isSeeking = true;
      seekFromEvent(e, bar);
    });
    document.addEventListener('mousemove', function(e) {
      if (!isSeeking) return;
      const bar = document.querySelector('.swipe-card.active .player-bar__progress');
      if (bar) seekFromEvent(e, bar);
    });
    document.addEventListener('mouseup', () => { isSeeking = false; });

    document.addEventListener('touchstart', function(e) {
      const bar = e.target.closest('.player-bar__progress');
      if (!bar) return;
      isSeeking = true;
      seekFromEvent(e, bar);
    }, { passive: true });
    document.addEventListener('touchmove', function(e) {
      if (!isSeeking) return;
      const bar = document.querySelector('.swipe-card.active .player-bar__progress');
      if (bar) seekFromEvent(e, bar);
    }, { passive: true });
    document.addEventListener('touchend', () => { isSeeking = false; });

    // Délégation : le clic sur n'importe quel toggle de card active
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.player-bar__toggle');
      if (!btn) return;
      const { audio } = getActiveBar();
      if (!audio) return;
      if (playerPaused) {
        audio.play().catch(() => {});
        playerPaused = false;
      } else {
        audio.pause();
        playerPaused = true;
      }
      updatePlayerIcon();
    });

    function unlockAudio() {
      if (window.__newsicAudioUnlocked) return;

      window.__newsicAudioUnlocked = true;

      const overlay = document.getElementById('tap-overlay');
      if (overlay) overlay.style.display = 'none';

      playCurrentAudio();
    }

    window.flipCard = function (event, element) {
      if (event.target.closest('.swipe-buttons')) return;
      if (event.target.closest('.card-actions')) return;
      if (event.target.closest('.card-player-bar')) return;
      element.classList.toggle('is-flipped');
    };

    window.vote = function (btn, status) {
      unlockAudio();

      const card = document.querySelector('.swipe-card.active');
      const container = document.querySelector('.swipe-container');
      const recapUrl = container ? container.dataset.recapUrl : '/';

      fetch(card.dataset.voteUrl, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ status })
      });

      card.classList.add(status === 'liked' ? 'fly-right' : 'fly-left');

      setTimeout(() => {
        card.remove();

        const remaining = document.querySelectorAll('.swipe-card');

        if (remaining.length === 0) {
          window.location.href = recapUrl;
        } else {
          remaining[0].classList.add('active');
          playCurrentAudio();
        }
      }, 400);
    };

    let startX = 0;

    document.addEventListener('touchstart', e => {
      startX = e.touches[0].clientX;
    });

    document.addEventListener('touchend', e => {
      const diff = e.changedTouches[0].clientX - startX;
      const active = document.querySelector('.swipe-card.active');

      if (!active) return;

      if (diff > 80) window.vote(null, 'liked');
      if (diff < -80) window.vote(null, 'disliked');
    });

    function initPage() {
      const container = document.querySelector('.swipe-container');
      if (!container || container.dataset.swipeReady === '1') return;

      container.dataset.swipeReady = '1';

      // Reset audio unlock state on each page init so the overlay works on every visit
      window.__newsicAudioUnlocked = false;
      playerPaused = false;

      const overlay = document.getElementById('tap-overlay');
      if (overlay) overlay.addEventListener('click', unlockAudio);

      const filtersToggle = document.getElementById('filters-toggle');
      const filtersPanel  = document.getElementById('filters-panel');
      const filtersClose  = document.getElementById('filters-close');

      if (filtersToggle && filtersPanel) {
        filtersToggle.addEventListener('click', () => filtersPanel.classList.add('open'));
      }

      if (filtersClose && filtersPanel) {
        filtersClose.addEventListener('click', () => filtersPanel.classList.remove('open'));
      }

      const resetBtn = document.getElementById('btn-reset-filters');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          const form = document.querySelector('.filters-form');
          if (!form) return;
          // Reset all native inputs
          form.reset();
          // Reset hidden decade/tempo inputs and their labels
          const decadeHidden = document.getElementById('decade-hidden');
          const tempoHidden  = document.getElementById('tempo-hidden');
          if (decadeHidden) decadeHidden.value = '';
          if (tempoHidden)  tempoHidden.value  = '';
          document.getElementById('decade-label') && (document.getElementById('decade-label').textContent = '');
          document.getElementById('tempo-label')  && (document.getElementById('tempo-label').textContent  = '');
          document.getElementById('decade-block')?.classList.remove('is-active');
          document.getElementById('tempo-block')?.classList.remove('is-active');
          // Clear seed chips
          document.getElementById('seed-chips') && (document.getElementById('seed-chips').innerHTML = '');
          document.getElementById('seed-inputs') && (document.getElementById('seed-inputs').innerHTML = '');
          // Submit with clean state
          form.submit();
        });
      }

      const active = document.querySelector('.swipe-card.active');

      if (active) {
        const cardAudio = active.querySelector('.card-audio');
        cardAudio.addEventListener('playing', function() {
          if (window.__newsicAudioUnlocked) return;
          window.__newsicAudioUnlocked = true;
          if (overlay) overlay.style.display = 'none';
          const { fill } = getActiveBar();
          if (fill) bindProgressBar(cardAudio, fill);
          updatePlayerIcon();
        }, { once: true });
        cardAudio.play().catch(() => {});
      }

      initSeedSearch();
    }

    document.addEventListener('turbo:load', initPage);
    document.addEventListener('DOMContentLoaded', initPage);

    document.addEventListener('turbo:before-cache', function() {
      const container = document.querySelector('.swipe-container');
      if (!container) return;
      delete container.dataset.swipeReady;
      document.querySelectorAll('.card-audio').forEach(a => { a.pause(); a.currentTime = 0; });
      playerPaused = false;
      window.__newsicAudioUnlocked = false;
      const overlay = document.getElementById('tap-overlay');
      if (overlay) overlay.style.display = '';
    });

    function initSeedSearch() {
      const root = document.getElementById('seed-search');
      if (!root) return;

      const searchUrl = root.dataset.searchUrl;
      const input     = document.getElementById('seed-input');
      const resultsEl = document.getElementById('seed-results');
      const chipsEl   = document.getElementById('seed-chips');
      const inputsEl  = document.getElementById('seed-inputs');

      let seeds = [];

      JSON.parse(root.dataset.initialArtists || '[]').forEach(name => {
        seeds.push({ kind: 'artist', value: name, label: name });
      });

      JSON.parse(root.dataset.initialTracks || '[]').forEach(entry => {
        const [artist, title] = entry.split('|');
        seeds.push({ kind: 'track', value: entry, label: title + ' — ' + artist });
      });

      function render() {
        chipsEl.innerHTML = '';
        inputsEl.innerHTML = '';

        seeds.forEach((s, i) => {
          const chip = document.createElement('span');
          chip.className = 'seed-chip';

          const txt = document.createElement('span');
          txt.textContent = (s.kind === 'artist' ? '🎤 ' : '🎵 ') + s.label;

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = '×';
          btn.addEventListener('click', () => {
            seeds.splice(i, 1);
            render();
          });

          chip.append(txt, btn);
          chipsEl.appendChild(chip);

          const hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = s.kind === 'artist' ? 'seed_artists[]' : 'seed_tracks[]';
          hidden.value = s.value;

          inputsEl.appendChild(hidden);
        });
      }

      function addSeed(seed) {
        const dup = seeds.some(s => {
          return s.kind === seed.kind && s.value.toLowerCase() === seed.value.toLowerCase();
        });

        if (!dup) {
          seeds.push(seed);
          render();
        }

        input.value = '';
        resultsEl.innerHTML = '';
      }

      function resultRow(emoji, text, seed) {
        const row = document.createElement('div');
        row.className = 'seed-result';
        row.textContent = emoji + ' ' + text;
        row.addEventListener('click', () => addSeed(seed));
        return row;
      }

      function renderResults(data) {
        resultsEl.innerHTML = '';

        (data.artists || []).forEach(a => {
          resultsEl.appendChild(
            resultRow('🎤', a.name, { kind: 'artist', value: a.name, label: a.name })
          );
        });

        (data.tracks || []).forEach(t => {
          const label = t.title + ' — ' + t.artist;

          resultsEl.appendChild(
            resultRow('🎵', label, {
              kind: 'track',
              value: t.artist + '|' + t.title,
              label: label
            })
          );
        });
      }

      let timer = null;

      input.addEventListener('input', () => {
        clearTimeout(timer);

        const q = input.value.trim();

        if (q.length < 2) {
          resultsEl.innerHTML = '';
          return;
        }

        timer = setTimeout(() => {
          fetch(searchUrl + '?q=' + encodeURIComponent(q), {
            headers: { 'Accept': 'application/json' }
          })
            .then(r => r.json())
            .then(renderResults)
            .catch(() => {
              resultsEl.innerHTML = '';
            });
        }, 300);
      });

      document.addEventListener('click', e => {
        if (!root.contains(e.target)) resultsEl.innerHTML = '';
      });

      render();
    }
  })();
</script>
