<div class="profile-page" data-controller="profile">
  <header class="profile-header">
    <div class="profile-avatar"><%= avatar_for(@user, size: 96) %></div>
    <h1 class="profile-name"><%= @user.display_name %></h1>

    <div class="friend-code" data-controller="clipboard" data-clipboard-text-value="<%= @user.friend_code %>">
      <span class="friend-code__value">#<%= @user.friend_code %></span>
      <button type="button" class="friend-code__copy" data-action="clipboard#copy">Copier</button>
    </div>
    <p class="friend-code__hint">Partage ce code pour qu'on t'ajoute en ami.</p>

    <div class="profile-stats">
      <div class="profile-stat">
        <span class="profile-stat__num"><%= @playlist_count %></span>
        <span class="profile-stat__label">Sessions</span>
      </div>
      <button type="button" class="profile-stat profile-stat--btn"
              data-action="click->profile#toggleFriends">
        <span class="profile-stat__num"><%= @friend_count %></span>
        <span class="profile-stat__label">Amis</span>
      </button>
    </div>

    <div class="friends-drawer" data-profile-target="friends">
      <% if @friends.any? %>
        <% @friends.each do |friend| %>
          <%= link_to user_path(friend), class: "friends-drawer__item" do %>
            <%= avatar_for(friend, size: 36) %>
            <span class="friends-drawer__name"><%= friend.display_name %></span>
          <% end %>
        <% end %>
      <% else %>
        <p class="friends-drawer__empty">Pas encore d'amis.</p>
      <% end %>
    </div>
  </header>

  <% if @user.top_genres.present? %>
    <section class="profile-section">
      <h2 class="profile-section__title">Genres préférés</h2>
      <div class="tag-cloud">
        <% @user.top_genres.each do |genre| %>
          <span class="tag"><%= genre %></span>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @user.artist_cards.any? %>
    <section class="profile-section">
      <h2 class="profile-section__title">Artistes les plus écoutés</h2>
      <div class="artist-cards">
        <% @user.artist_cards.each do |artist| %>
          <%= link_to artist_path(name: artist["name"]), class: "artist-card" do %>
            <% if artist["image"].present? %>
              <%= image_tag artist["image"], alt: "", class: "artist-card__img" %>
            <% else %>
              <div class="artist-card__fallback">🎤</div>
            <% end %>
            <span class="artist-card__name"><%= artist["name"] %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="profile-section">
    <%= link_to "Trouver des amis", users_path, class: "profile-action" %>
    <%= button_to "Se déconnecter", logout_path, method: :delete, class: "profile-action profile-action--ghost" %>
  </section>
</div>
