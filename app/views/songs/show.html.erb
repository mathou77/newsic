<div class="song-detail">
  <header class="song-detail__top">
    <%= link_to "javascript:history.back()", class: "song-detail__back" do %>
      <i class="fa-solid fa-chevron-left"></i>
    <% end %>
  </header>

  <% if @song.image_url.present? %>
    <img class="song-detail__cover" src="<%= @song.image_url %>" alt="<%= @song.title %>">
  <% else %>
    <div class="song-detail__cover song-detail__cover--ph">♪</div>
  <% end %>

  <h1 class="song-detail__title"><%= @song.title %></h1>
  <p class="song-detail__artist"><%= @song.artist %></p>

  <% if @song.preview_url.present? %>
    <div class="song-detail__player" data-controller="preview">
      <audio data-preview-target="audio" src="<%= preview_song_path(@song) %>" preload="none"></audio>
      <button type="button" class="song-detail__play" data-action="preview#toggle" data-preview-target="button">
        <i class="fa-solid fa-play"></i> Écouter l'extrait
      </button>
    </div>
  <% end %>

  <dl class="song-detail__meta">
    <% if @song.genre.present? %>
      <div><dt>Genre</dt><dd><%= @song.genre %></dd></div>
    <% end %>
    <div><dt>Artiste</dt><dd><%= @song.artist %></dd></div>
  </dl>
</div>
