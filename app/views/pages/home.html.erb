<div class="home">
  <% if session[:access_token] %>
    <p>Bonjour <%= session[:display_name] %> !</p>
    <%= button_to "Se déconnecter", logout_path, method: :delete %>
  <% else %>
    <%= link_to "Se connecter avec Spotify", "/auth/spotify", data: { turbo: false }, class: "btn-spotify" %>
  <% end %>
</div>
