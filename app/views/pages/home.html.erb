<div class="onboarding-page home-page">
  <div class="brand">
    <%= image_tag "logo-orb.png", class: "brand-logo", alt: "Newsic" %>
    <div>
      <h1>NEWSIC</h1>
      <p>La musique à portée de main</p>
    </div>
  </div>

  <div class="onboarding-content">
    <% if session[:access_token] %>
      <% if current_user&.avatar_url.present? %>
        <img src="<%= current_user.avatar_url %>" alt="avatar" class="home-avatar">
      <% end %>
      <p class="welcome-text">Bonjour <%= session[:display_name]&.split&.first %> !</p>

      <h2>Prêt·e à découvrir de nouveaux sons ?</h2>

      <div class="home-cta">
        <p class="home-cta-label">Tape sur le logo ci-dessous pour commencer</p>
      </div>
    <% else %>
      <h2>Connectez-vous pour découvrir de nouveaux sons</h2>

      <%= link_to "Se connecter avec Spotify",
                  "/auth/spotify",
                  data: { turbo: false },
                  class: "spotify-button" %>
    <% end %>
  </div>

</div>
