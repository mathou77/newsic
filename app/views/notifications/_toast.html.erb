<div id="toast_<%= notification.id %>"
     class="notif-toast"
     data-controller="toast"
     data-toast-duration-value="<%= notification.friend_request? ? 0 : 4500 %>">

  <% actor = notification.actor %>
  <% msg   = notification.notifiable %>

  <%# Avatar with Newsic logo badge %>
  <div class="notif-toast__avatar-wrap">
    <% if actor.avatar_url.present? %>
      <%= image_tag actor.avatar_url, class: "notif-toast__img", alt: "" %>
    <% else %>
      <span class="notif-toast__initials"><%= actor.initials %></span>
    <% end %>
    <%= image_tag "logo-orb.png", class: "notif-toast__newsic-badge", alt: "" %>
  </div>

  <div class="notif-toast__body">
    <p class="notif-toast__name"><%= actor.display_name %></p>

    <p class="notif-toast__action">
      <% case notification.kind %>
      <% when "message" %>
        <% if msg&.song.present? %>
          A partagé "<%= msg.song.title %>" par <%= msg.song.artist %>
        <% elsif msg&.body.present? %>
          <%= msg.body.truncate(80) %>
        <% end %>
      <% when "friend_request" %>
        A envoyé une demande d'ami
      <% when "reaction" %>
        A réagi à votre message <%= msg&.emoji %>
      <% end %>
    </p>

    <% if notification.friend_request? %>
      <div class="notif-toast__actions">
        <%= button_to "Accepter", accept_notification_path(notification),
              class: "notif-btn notif-btn--accept",
              data: { turbo_stream: true } %>
        <%= button_to "Décliner", decline_notification_path(notification),
              class: "notif-btn notif-btn--decline",
              data: { turbo_stream: true } %>
      </div>
    <% end %>
  </div>

  <% unless notification.friend_request? %>
    <% url = notification.conversation_id ? conversation_path(notification.conversation_id) : conversations_path %>
    <%= link_to url, class: "notif-toast__link" do %>
      <span class="sr-only">Voir</span>
    <% end %>
  <% end %>

  <%= button_to mark_read_notification_path(notification), method: :patch,
        class: "notif-toast__close",
        aria: { label: "Fermer" },
        data: { turbo_stream: true } do %>
    <i class="fa-solid fa-xmark"></i>
  <% end %>
</div>
