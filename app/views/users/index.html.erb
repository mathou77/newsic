<div class="users-page">
  <h1 class="page-title">Trouver des amis</h1>

  <%= form_with url: users_path, method: :get,
                data: { controller: "search", turbo_frame: "users_results", turbo_action: "replace" },
                class: "user-search" do %>
    <i class="fa-solid fa-magnifying-glass user-search__icon"></i>
    <%= text_field_tag :q, params[:q], placeholder: "Nom ou code ami (#ABC123)…",
                       class: "user-search__input", autocomplete: "off",
                       data: { action: "input->search#submit" } %>
  <% end %>

  <%= turbo_frame_tag "users_results" do %>
    <% if @users.empty? %>
      <p class="empty-state">
        <% if params[:q].present? %>
          Aucun résultat pour « <%= params[:q] %> ».
        <% else %>
          Personne d'autre n'a encore rejoint Newsic. Reviens quand tes amis se seront connectés avec Spotify !
        <% end %>
      </p>
    <% else %>
      <ul class="user-list">
        <% @users.each do |user| %>
          <li class="user-row">
            <%= link_to user_path(user), class: "user-row__main" do %>
              <span class="user-row__avatar"><%= avatar_for(user, size: 48) %></span>
              <span class="user-row__info">
                <span class="user-row__name"><%= user.display_name %></span>
                <span class="user-row__genres">
                  #<%= user.friend_code %><% if user.top_genres.present? %> · <%= user.top_genres.first(2).join(" · ") %><% end %>
                </span>
              </span>
            <% end %>
            <%= render "users/friend_actions", user: user, friendship: current_user.friendship_with(user) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
